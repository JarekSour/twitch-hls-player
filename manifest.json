{
  "manifest_version": 3,
  "name": "Twitch HLS Player",
  "version": "0.2.0",
  "description": "Reemplaza el reproductor de Twitch por uno con hls.js que filtra los anuncios de la playlist.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Twitch HLS Player",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.twitch.tv/*"],
      "js": ["vendor/hls.min.js", "playlist.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
